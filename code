// TC07: Verify empty search
test('TC07 - Display All Jobs for Empty Search', async ({ page }) => {
  await page.goto(`${BASE_URL}/jobs`);

  const searchBox = page.getByPlaceholder(
    'Search by job title, company or location...'
  );

  await searchBox.fill('Frontend Developer');

  await expect(page.locator('.job-card')).toHaveCount(1);

  await searchBox.fill('');

  await expect(page.locator('.job-card')).toHaveCount(6);

