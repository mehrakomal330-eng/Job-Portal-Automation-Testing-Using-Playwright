// TC08: Verify job application submission
test('TC08 - Submit a Job Application', async ({ page }) => {
  await page.goto(`${BASE_URL}/job-details`);

  await page.getByPlaceholder('Enter your name')
    .fill('Test Applicant');

  await page.getByPlaceholder('Enter your email')
    .fill('applicant@example.com');

  await page.getByPlaceholder('Enter your phone number')
    .fill('9876543210');

  await page.locator('input[type="file"]').setInputFiles({
    name: 'resume.pdf',
    mimeType: 'application/pdf',
    buffer: Buffer.from('%PDF-1.4 test resume')
  });

  await page.getByRole('button', {
    name: 'Submit Application'
  }).click();

  await expect(page.getByText(
    'Application Submitted Successfully!'
  )).toBeVisible();
});

// TC09: Verify profile editing
test('TC09 - Update User Profile', async ({ page }) => {
  await prepareUser(page);

  page.on('dialog', dialog => dialog.accept());

  await page.goto(`${BASE_URL}/edit-profile`);

  await page.locator('input[name="name"]').fill('Updated Test User');

  await page.getByRole('button', {
    name: 'Save Changes'
  }).click();

  await expect(page).toHaveURL(/\/dashboard$/);

  const savedUser = await page.evaluate(
    () => JSON.parse(localStorage.getItem('jobPortalUser'))
  );

  expect(savedUser.name).toBe('Updated Test User');
});

test('TC10 - Logout and Check Dashboard Access', async ({ page }) => {
  // Open website first
  await page.goto(BASE_URL);

  // Set login data only once
  await page.evaluate((user) => {
    localStorage.setItem('jobPortalUser', JSON.stringify(user));
    localStorage.setItem('isLoggedIn', 'true');
  }, testUser);

  // Open dashboard
  await page.goto(`${BASE_URL}/dashboard`);

  await expect(
    page.getByRole('heading', { name: /welcome back/i })
  ).toBeVisible();

  // Logout
  await page.getByRole('button', { name: 'Logout' }).click();

  await expect(page).toHaveURL(/\/login$/);

  // Confirm login status is removed
  expect(
    await page.evaluate(() => localStorage.getItem('isLoggedIn'))
  ).toBeNull();

  // Try opening dashboard after logout
  await page.goto(`${BASE_URL}/dashboard`);

  // User should be redirected to login
  await expect(page).toHaveURL(/\/login$/, { timeout: 10000 });
});
